# Скопируйте в .env и заполните. Для демо-режима (python demo.py) .env не нужен.

# Токен бота от @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# Часовой пояс и время ежедневного напоминания
TIMEZONE=Asia/Almaty
NOTIFY_TIME=09:00

# За сколько дней предупреждать заранее (через запятую). В сам день рождения бот пишет всегда.
REMIND_DAYS_BEFORE=7,2,1

# Ваш Telegram ID (необязательно). Если пусто — владельцем станет тот, кто первым нажмёт /start.
OWNER_ID=your-telegram-user-id

# Кто ещё видит раздел праздников и получает собранные пожелания (Telegram ID через запятую, необязательно).
HOLIDAY_VIEWERS=
WISH_RECIPIENTS=

# Google-таблица со списком, полом и текстами поздравлений (ID из ссылки docs.google.com/spreadsheets/d/<ID>/edit).
# Доступ к таблице: «Все, у кого есть ссылка — читатель». Пусто — бот работает по data/birthdays.json.
SHEET_ID=your-google-sheet-id

# 1 — утренние сообщения шлёт и этот компьютер. Обычно 0: их шлёт сервер по будильнику.
LOCAL_NOTIFY=0

# Apps Script в таблице (apps_script.template.gs) — чтобы бот мог добавлять и удалять людей.
SHEET_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_DEPLOYMENT_ID/exec
SHEET_WEBAPP_SECRET=your-shared-secret-here

# Хостинг PythonAnywhere: секрет webhook (любая длинная строка) и API-токен (Account → API token).
WEBHOOK_SECRET=your-webhook-secret-here
PA_USERNAME=your-pythonanywhere-username
PA_API_TOKEN=your-pythonanywhere-api-token
# Адрес Mini App (по умолчанию https://<PA_USERNAME>.pythonanywhere.com/app)
WEBAPP_URL=https://example.com/app

# Сбор на подарок: за сколько дней до ДР, по сколько и куда переводить.
GIFT_DAYS_BEFORE=5
GIFT_AMOUNT=2000
GIFT_PAYEE=your-payee-name-or-phone

# AI-тексты поздравлений (Google Gemini, ключ — aistudio.google.com). Модели по очереди: GEMINI_MODELS=
GEMINI_API_KEY=your-gemini-api-key-here
